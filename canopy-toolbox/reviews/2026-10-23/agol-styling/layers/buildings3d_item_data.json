   "popupInfo": {
    "title": "Building {FP_ID}",
    "expressionInfos": [
     {
      "name": "h50",
      "title": "Median roof height",
      "expression": "var m = $feature.HEIGHT_P50_M;\nif (IsEmpty(m)) { return 'no estimate'; }\nreturn Text(m / 0.3048, '#,##0.0') + ' ft';",
      "returnType": "string"
     },
     {
      "name": "h95",
      "title": "95th percentile roof height",
      "expression": "var m = $feature.HEIGHT_P95_M;\nif (IsEmpty(m)) { return 'no estimate'; }\nreturn Text(m / 0.3048, '#,##0.0') + ' ft';",
      "returnType": "string"
     },
     {
      "name": "support",
      "title": "Roof support",
      "expression": "var c = $feature.ROOF_COV_PCT;\nif (IsEmpty(c)) { return 'none'; }\nreturn Text(c, '#,##0') + '% of the footprint\\'s roughly 1.6 ft grid cells have lidar roof points';",
      "returnType": "string"
     },
     {
      "name": "flags",
      "title": "Notes",
      "expression": "var words = Dictionary(\"LOW_ROOF_SUPPORT\", \"Lidar roof points cover less than 80% of the footprint, so the height is less certain.\", \"NO_ROOF_SUPPORT\", \"No lidar roof points fall inside the footprint, so no height was estimated.\", \"NO_CELL_CENTERS\", \"The footprint is too small to hold a 0.5 m cell centre, so no height was estimated.\", \"NEGATIVE_HEIGHT\", \"Some roof cells sit below the ground surface; the footprint may not match the building.\", \"PARTIAL_AOI\", \"Part of the footprint lies outside the lidar coverage.\", \"GEOMETRY_REPAIRED\", \"The county footprint's shape was repaired before measuring.\");\nvar parts = Split(DefaultValue($feature.HEIGHT_STATUS, ''), ';');\nvar out = [];\nfor (var i in parts) { if (HasKey(words, parts[i])) { Push(out, words[parts[i]]); } }\nreturn IIf(Count(out) == 0, 'None beyond the estimate warning.', Concatenate(out, ' '));",
      "returnType": "string"
     },
     {
      "name": "area",
      "title": "Footprint",
      "expression": "var a = $feature.FOOTPRINT_M2;\nif (IsEmpty(a)) { return 'unknown'; }\nreturn Text(a / (0.3048 * 0.3048), '#,##0') + ' sq ft';",
      "returnType": "string"
     },
     {
      "name": "roof_area_m2_feet",
      "title": "Modelled roof surface (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.ROOF_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     },
     {
      "name": "ridge_ht_m_feet",
      "title": "Modelled ridge height above ground (ft)",
      "returnType": "number",
      "expression": "var v = $feature.RIDGE_HT_M;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048);"
     },
     {
      "name": "eave_ht_m_feet",
      "title": "Modelled eave height above ground (ft)",
      "returnType": "number",
      "expression": "var v = $feature.EAVE_HT_M;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048);"
     },
     {
      "name": "flat_area_m2_feet",
      "title": "Roof surface under 5 degrees (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.FLAT_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     },
     {
      "name": "south_area_m2_feet",
      "title": "South-facing roof surface (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.SOUTH_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     },
     {
      "name": "east_area_m2_feet",
      "title": "East-facing roof surface (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.EAST_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     },
     {
      "name": "west_area_m2_feet",
      "title": "West-facing roof surface (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.WEST_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     },
     {
      "name": "north_area_m2_feet",
      "title": "North-facing roof surface (sq ft)",
      "returnType": "number",
      "expression": "var v = $feature.NORTH_AREA_M2;\nif (IsEmpty(v)) { return null; }\nreturn v / (0.3048 * 0.3048);"
     }
    ],
    "popupElements": [
     {
      "type": "text",
      "text": "<p><b>Roof model:</b> {LEVEL}</p>"
     },
     {
      "type": "text",
      "text": "<p><b>Roof height above the ground</b><br />Median: {expression/h50}<br />95th percentile: {expression/h95}</p><p><b>Roof support:</b> {expression/support}.</p><p><b>Notes:</b> {expression/flags}</p><p>Footprint {expression/area}. Parcel {PARCEL_ID}. County building ID {SOURCE_ID}.</p><p style='font-size:11px;color:#6b6b6b'>Unvalidated lidar planning estimate (2023 Salt Lake Valley QL1 lidar); not surveyed or field-verified.</p>"
     },
     {
      "type": "text",
      "text": "<p>Roof measurements below describe retained roofer models. They are empty for Esri fallback buildings. Facing areas cover slopes from 5 to 70 degrees; they do not estimate solar production.</p>"
