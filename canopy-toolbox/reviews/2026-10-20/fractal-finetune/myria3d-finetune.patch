+def pre_filter_no_labels(data, min_num_nodes=1, unlabelled=(250, 7, 65)):
+    """Drop a sample with too few points or without any labelled point (sparse-label fine-tuning, October 20, 2026).
+
+    Unlabelled: 250 (raw) or 7 (mapped), and 65, the artefact code that DropPointsByClass removes.
+    """
+    if data.pos.shape[0] < min_num_nodes:
+        return True
+    y = getattr(data, "y", None)
+    if y is None:
+        return False
+    import torch as _torch
+    return bool(_torch.isin(_torch.as_tensor(y), _torch.as_tensor(list(unlabelled))).all())
